{
    "text": {
        "autoconfig": {
            "woasts": {
                "title": "Woasts! §7(by itpuppy)§r",

                "option": {
                    "mainSwitch": {
                        "@": "Main Switch",
                        "@Tooltip": "Controls the rendering of all widgets."
                    },

                    "renderCorner": {
                        "@": "Render Corner",
                        "@Tooltip": "Specifies in which corner of the screen the widgets will be rendered.",

                        "upLeft": "Upper-Left",
                        "upRight": "Upper-Right",
                        "downLeft": "Lower-Left",
                        "downRight": "Lower-Right"
                    },

                    "margin": {
                        "@": "Margin",
                        "@Tooltip": "Specifies the margin from the edges of the screen."
                    },

                    "spacing": {
                        "@": "Spacing",
                        "@Tooltip": "Specifies the spacing between each widget."
                    },

                    "wrap": {
                        "@": "Wrap",
                        "@Tooltip": [
                            "Specifies the number of widgets allowed on a single line before wrapping.",
                            "§7Setting the value to zero or lower disables this feature.§r"
                        ]
                    },

                    "wrapSpacing": {
                        "@": "Wrap Spacing",
                        "@Tooltip": "Specifies the amount of spacing between each wrapped line."
                    },

                    "hideBackgroundOverride": {
                        "@": "Hide Background Override",
                        "@Tooltip": "If enabled, hides the background on all widgets."
                    },

                    "pingConfig": {
                        "@": "Ping Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "hideInSingleplayer": "Hide In Singleplayer",

                        "updateTime": {
                            "@": "Update Time",
                            "@Tooltip": "Specifies the amount of time (in seconds) between each ping update."
                        },

                        "greenPingRange": {
                            "@": "Green Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the green color.",
                                "",
                                "§7Follows the formula:",
                                "From [1] to [Value]§r"
                            ]
                        },

                        "yellowPingRange": {
                            "@": "Yellow Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the yellow color.",
                                "",
                                "§7Follows the formula, where X is the sum of all previous values:",
                                "From [X + 1] to [X + Value]§r"
                            ]
                        },

                        "orangePingRange": {
                            "@": "Orange Ping Range",
                            "@Tooltip": [
                                "Specifies the range of ping values for the orange color.",
                                "",
                                "§7Follows the formula, where X is the sum of all previous values:",
                                "From [X + 1] to [X + Value]",
                                "",
                                "All ping values after this range will result in the red ping color.§r"
                            ]
                        },

                        "grayPingColor": "Gray Ping Color",
                        "greenPingColor": "Green Ping Color",
                        "yellowPingColor": "Yellow Ping Color",
                        "orangePingColor": "Orange Ping Color",
                        "redPingColor": "Red Ping Color"
                    },

                    "positionConfig": {
                        "@": "Position Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "color": "Color"
                    },

                    "fpsConfig": {
                        "@": "FPS Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",

                        "optimalFps": {
                            "@": "Optimal FPS",
                            "@Tooltip": [
                                "Specifies the FPS value for widget coloring.",
                                "",
                                "§7Values below optimal FPS will be colored yellow.",
                                "Values above optimal FPS will be colored green.§r"
                            ]
                        },

                        "greenFpsColor": "Green FPS Color",
                        "yellowFpsColor": "Yellow FPS Color"
                    },

                    "biomeConfig": {
                        "@": "Biome Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "grassTextColor": {
                            "@": "Grass Text Color",
                            "@Tooltip": "Uses the biomes grass color as the color for the text."
                        },
                        "prettifiedIdentifier": {
                            "@": "Prettify Biome Name",
                            "@Tooltip": "Puts the biomes path into title case."
                        }
                    },

                    "irlTimeConfig": {
                        "@": "Irl Time Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "time24hFormat": "24 Hour Format"
                    },

                    "ingameTimeConfig": {
                        "@": "In-game Time Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "time24hFormat": "24 Hour Format",
                        "onlyShowInOverworld": {
                            "@": "Only Show In Overworld",
                            "@Tooltip": "Only shows the widget in the overworld, if disabled it shows the overworld time in other dimensions."
                        }
                    },

                    "weatherConfig": {
                        "@": "Weather Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "hideWhenClear": "Hide When Clear Weather"
                    },

                    "dayConfig": {
                        "@": "Day Widget",
                        "isEnabled": "Enabled",
                        "showBackground": "Show Background",
                        "onlyShowInOverworld": {
                            "@": "Only Show In Overworld",
                            "@Tooltip": "Only shows the widget in the overworld, if disabled it shows the overworld time in other dimensions."
                        }
                    }
                }
            }
        }
    }
}
